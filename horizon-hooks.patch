+/// A headset eye's panorama projection: `projection`'s, from the eye's own field of view, shape
+/// and turn (Horizon degrees).
+// shortcut: the roll's sign follows `projection`'s flipped frame by eye; check it in the headset.
+pub(super) fn eye_projection(
+    fov_degrees: f32,
+    fov_tangents: Option<[f32; 4]>,
+    aspect: f32,
+    yaw: f32,
+    pitch: f32,
+    roll: f32,
+) -> Mat4 {
+    let proj = match fov_tangents {
+        Some([l, r, b, t]) => {
+            let (near, far) = (0.05f32, 10.0f32);
+            let inv_w = 1.0 / (r - l);
+            let inv_h = 1.0 / (t - b);
+            let inv_d = 1.0 / (near - far);
+            Mat4::from_cols(
+                glam::Vec4::new(2.0 * inv_w, 0.0, 0.0, 0.0),
+                glam::Vec4::new(0.0, 2.0 * inv_h, 0.0, 0.0),
+                glam::Vec4::new((r + l) * inv_w, (t + b) * inv_h, far * inv_d, -1.0),
+                glam::Vec4::new(0.0, 0.0, (near * far) * inv_d, 0.0),
+            )
+        }
+        None => Mat4::perspective_rh(fov_degrees.to_radians(), aspect, 0.05, 10.0),
+    };
+    proj
+        * Mat4::from_rotation_z(roll.to_radians())
+        * Mat4::from_rotation_x(std::f32::consts::PI)
+        * Mat4::from_rotation_x(pitch.to_radians())
+        * Mat4::from_rotation_y(yaw.to_radians())
+}
