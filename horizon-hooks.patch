+
+/// Vivecraft's roomscale hands (`client_vr/gameplay/trackers/SwingTracker.java`, VivecraftMod,
+/// LGPL-3.0): the swing tracker breaks and hits through the same calls a click makes.
+impl Game<'_> {
+    /// A roomscale hit on a block: `startDestroyBlock`, then `hits` ticks of
+    /// `continueDestroyBlock` while it holds (faster swings send more), then a swing of `hand`.
+    /// Returns whether the block is still being broken.
+    pub(super) fn vr_roomscale_mine(
+        &mut self,
+        pos: [i32; 3],
+        face: u8,
+        hits: u32,
+        hand: Hand,
+    ) -> Result<bool> {
+        let mut clicks = std::mem::take(&mut self.clicks);
+        let mut world = GameHands {
+            game: self,
+            error: None,
+        };
+        clicks.destroying.start(&mut world, pos, face);
+        if clicks.destroying.active {
+            for _ in 0..hits {
+                clicks.destroying.continue_destroy(&mut world, pos, face);
+                if !clicks.destroying.active {
+                    break;
+                }
+            }
+            clicks.destroying.delay = 0;
+        }
+        let animation = world.attack_animation();
+        world.swing(hand, animation);
+        let error = world.error.take();
+        let still = clicks.destroying.active;
+        self.clicks = clicks;
+        match error {
+            Some(e) => Err(e),
+            None => Ok(still),
+        }
+    }
+
+    /// `stopDestroyBlock` for a roomscale hit the hand left.
+    pub(super) fn vr_stop_mining(&mut self) {
+        let mut clicks = std::mem::take(&mut self.clicks);
+        let mut world = GameHands {
+            game: self,
+            error: None,
+        };
+        clicks.destroying.stop(&mut world);
+        self.clicks = clicks;
+    }
+
+    /// `MultiPlayerGameMode.attack(player, entity)` on the mob `index` the weapon touched.
+    pub(super) fn vr_attack_mob(&mut self, index: usize, hand: Hand) -> bool {
+        let Some(m) = self.mobs.get(index) else {
+            return false;
+        };
+        let c = m.bounds().center();
+        let distance = self
+            .eye_position()
+            .map_or(0.0, |e| ((e[0] - c.x).powi(2) + (e[1] - c.y).powi(2) + (e[2] - c.z).powi(2)).sqrt());
+        let saved = (self.tick_mob, self.tick_hit.get());
+        self.tick_mob = Some(Some((index, distance, [c.x, c.y, c.z])));
+        self.tick_hit.set(Some(None));
+        let hit = self.attack();
+        if hit {
+            self.reset_attack_strength();
+            self.swing_hand(hand, SwingAnimation::DEFAULT);
+        }
+        self.tick_mob = saved.0;
+        self.tick_hit.set(saved.1);
+        hit
+    }
+
+    /// `MultiPlayerGameMode.useItemOn` at a roomscale touch (`InteractTracker`, door punching):
+    /// uses `hand` on the block `hit` as a click on it would.
+    pub(super) fn vr_use_on(&mut self, hit: super::Hit, _hand: Hand) -> Result<()> {
+        let saved = self.tick_hit.get();
+        self.tick_hit.set(Some(Some(hit)));
+        let r = self.use_with_hand();
+        self.tick_hit.set(saved);
+        r
+    }
+}
+
+impl Game<'_> {
+    /// `MultiPlayerGameMode.interact` on the mob `index` a hand is in (`EntityInteractionModule`).
+    pub(super) fn vr_interact_mob(&mut self, index: usize) -> Result<()> {
+        let Some(m) = self.mobs.get(index) else {
+            return Ok(());
+        };
+        let c = m.bounds().center();
+        let saved = (self.tick_mob, self.tick_hit.get());
+        self.tick_mob = Some(Some((index, 0.0, [c.x, c.y, c.z])));
+        self.tick_hit.set(Some(None));
+        let r = self.use_with_hand();
+        self.tick_mob = saved.0;
+        self.tick_hit.set(saved.1);
+        r
+    }
+}
