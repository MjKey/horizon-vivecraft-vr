+/// The VR controllers (`horizon_vr::pad`) as a pad's state; at rest while VR is off.
+fn vr_pad() -> PadState {
+    let Some(vr) = horizon_vr::pad() else {
+        return PadState::default();
+    };
+    // A trigger a tracker took (the bow's draw, a hand's touch) neither attacks nor uses.
+    let taken = super::vr_trackers::vr_taken_triggers();
+    // With the menu panel up, the right trigger and grip are the laser's clicks.
+    let menu = horizon_vr::gui_open();
+    let triggers = [0, 1].map(|k| if taken[k] || (menu && k == 1) { 0.0 } else { vr.triggers[k] });
+    let mut state = PadState {
+        buttons: 0,
+        left: super::vr_run::vr_run_stick().unwrap_or(vr.left),
+        // The right stick turns (x) and teleports (y): it never looks.
+        right: [0.0, 0.0],
+        triggers,
+    };
+    let y_started_on_menu = {
+        let mut held = VR_Y_ON_MENU.lock().unwrap_or_else(|e| e.into_inner());
+        if !vr.north {
+            *held = None;
+        }
+        vr.north.then(|| *held.get_or_insert(menu))
+    };
+    let y_opens = y_started_on_menu == Some(false) && !menu;
+    let y_closes = y_started_on_menu == Some(true) && menu;
+    for (button, down) in [
+        (Button::South, vr.south),
+        // In game B is Vivecraft's radial menu key (`vr_radial`), on menus the pad's B.
+        // Vivecraft's inventory key (Y) also closes a menu, as B does: one press, one toggle
+        // (a held Y keeps the action it started with, instead of reopening each frame).
+        (Button::East, vr.east && menu || y_closes),
+        (Button::West, vr.west),
+        (Button::North, y_opens),
+        (Button::LeftBumper, vr.left_bumper && !super::vr_climb_claws::vr_boots_take_grips()),
+        (Button::RightBumper, vr.right_bumper && !menu && !super::vr_camera::vr_camera_touched() && !super::vr_climb_claws::vr_boots_take_grips()),
+        (Button::Start, vr.start),
+        // Vivecraft's `autoSprint` (on, `autoSprintThreshold` 0.9): the walk stick pushed all the
+        // way forward sprints.
+        (Button::LeftStick, vr.left_stick || (state.left[1] >= 0.9 && !menu)),
+        (Button::RightStick, vr.right_stick),
+    ] {
+        state.set(button, down);
+    }
+    state
+}
