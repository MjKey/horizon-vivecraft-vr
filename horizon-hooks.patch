+/// The laser's buttons (trigger, grip) at the last poll, for presses and releases.
+static VR_GUI_BUTTONS: std::sync::Mutex<[bool; 2]> = std::sync::Mutex::new([false; 2]);
+
+impl Game<'_> {
+    /// Vivecraft's `GuiHandler` for menus in VR: the panel shows while a menu is open, the main
+    /// controller's laser moves the pointer over it, the trigger left-clicks and the grip
+    /// right-clicks, through the pad's own pointer.
+    pub(super) fn vr_gui_frame(&mut self, event_loop: &dyn EventLoopCtl) {
+        if horizon_vr::sim_mode() && self.player.is_some() {
+            let rotation = super::vr_player::vr_player().as_ref().map_or(0.0, |v| v.world_rotation.to_radians());
+            horizon_vr::simulate(self.yaw, self.pitch, rotation);
+        }
+        let running = horizon_vr::pad().is_some();
+        let open = running && (self.screen != Screen::Playing || self.title.is_some());
+        horizon_vr::set_gui_open(open);
+        horizon_vr::set_hud(running && !open && self.player.is_some());
+        horizon_vr::set_in_world(self.player.is_some() && self.title.is_none());
+        let pad = horizon_vr::pad();
+        let now = if open {
+            pad.map_or([false; 2], |p| [p.triggers[1] > 0.5, p.right_bumper])
+        } else {
+            [false; 2]
+        };
+        if open
+            && let Some([u, v]) = horizon_vr::gui_pointer()
+            && let Some(batch) = self.gui_batch()
+        {
+            self.pad_pointer_to(event_loop, (u * batch.width, v * batch.height));
+        }
+        let was = std::mem::replace(
+            &mut *VR_GUI_BUTTONS.lock().unwrap_or_else(|e| e.into_inner()),
+            now,
+        );
+        for (k, right) in [(0, false), (1, true)] {
+            if now[k] != was[k] {
+                // The keyboard over the screen: the trigger types the key it points at, and
+                // pointing off the keyboard closes it (the click goes on to the screen).
+                if !right && let Some(keyboard) = self.pad.menu.osk.as_mut() {
+                    if keyboard.key_at(self.cursor) {
+                        if now[k]
+                            && let Some(out) = keyboard.press()
+                        {
+                            self.pad_osk_output(out);
+                        }
+                        continue;
+                    }
+                    if now[k] {
+                        self.pad.menu.osk = None;
+                    }
+                }
+                self.pad_pointer_button(event_loop, right, now[k]);
+                // The trigger on a text field (world name, search boxes) opens the
+                // on-screen keyboard, as the pad's A does: the controllers have no keys.
+                if !right
+                    && now[k]
+                    && self.pad.menu.osk.is_none()
+                    && field_at(&self.pad_targets(), self.cursor)
+                {
+                    self.pad_open_keyboard();
+                }
+            }
+        }
+    }
+}
