+                    if t.size != view.size || t.format != format {
+                        *t = Target::new(&self.device, view.size, format);
+                    }
+                })
+                .or_insert_with(|| Target::new(&self.device, view.size, format));
+            let aspect = view.size[0] as f32 / view.size[1].max(1) as f32;
+            let m = super::panorama::eye_projection(
+                view.fov_degrees,
+                aspect,
+                view.yaw - frame.yaw,
+                view.pitch,
+                view.roll,
+            );
+            self.panorama.upload(&mut self.uploads, encoder, m);
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("Horizon VR title eye"),
+                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                        view: &target.color_view,
+                        resolve_target: None,
+                        depth_slice: None,
+                        ops: wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                            store: wgpu::StoreOp::Store,
+                        },
+                    })],
+                    depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                        view: &target.depth,
+                        depth_ops: Some(wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(0.0),
+                            store: wgpu::StoreOp::Store,
+                        }),
+                        stencil_ops: None,
+                    }),
+                    ..Default::default()
+                });
+                self.panorama.draw(&mut pass);
+            }
+            horizon_vr::eye_drawn(
+                view.id,
+                &self.device,
+                &self.queue,
+                encoder,
+                &target.color,
+                &target.depth,
+                Mat4::IDENTITY,
+            );
+        }
+        self.world_views.targets = targets;
+        self.world_views.sections.put_back(views);
     }
 }
 
