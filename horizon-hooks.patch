+/// Reversed-Z right-handed off-center perspective for asymmetric VR eye frusta
+/// (`[tan_left, tan_right, tan_down, tan_up]`, matching `world_projection`'s `[0, 1]` reversed-Z).
+pub(crate) fn world_projection_asymmetric([l, r, b, t]: [f32; 4], far: f32) -> Mat4 {
+    let near = NEAR_PLANE;
+    let inv_w = 1.0 / (r - l);
+    let inv_h = 1.0 / (t - b);
+    let inv_d = 1.0 / (far - near);
+    Mat4::from_cols(
+        glam::Vec4::new(2.0 * inv_w, 0.0, 0.0, 0.0),
+        glam::Vec4::new(0.0, 2.0 * inv_h, 0.0, 0.0),
+        glam::Vec4::new((r + l) * inv_w, (t + b) * inv_h, near * inv_d, -1.0),
+        glam::Vec4::new(0.0, 0.0, (near * far) * inv_d, 0.0),
+    )
+}
